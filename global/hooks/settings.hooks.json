{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/git-safety.py"
        }
      ]
    },
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/understand-write-guard.py"
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/context-structure-guard.py"
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/index-line-budget-guard.py"
        }
      ]
    },
    {
      "matcher": "Write",
      "hooks": [
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/artifact-write-guard.py"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/hooks/check-state-size.sh"
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/hooks/context-surface-size-note.sh"
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/diff-size-guard.py"
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/context-cost-note.py"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/hooks/check-state-size.sh"
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/hooks/context-surface-size-note.sh"
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/hooks/diff-size-guard.py"
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/hooks/drift-check.sh"
        }
      ]
    }
  ]
}
