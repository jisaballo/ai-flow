#!/bin/sh
# pre-push: the trunk on a remote is never rewritten and never deleted.
#
# What decides is what git reports on standard input — one line per ref it is about to update:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# and nothing else is available here. There is no command text to read, so the question that defeated
# every earlier version of this protection — is git being invoked, or merely written about? — cannot be
# asked here and does not need to be. A document that quotes a forbidden operation is a document; it
# reaches no hook at all. The same silence is why the quote splits that defeated the text guard are
# gone: git resolves the command long before this line runs, and reports what it resolved.
#
# Three facts settle every case, each read rather than inferred:
#
#   * the destination is the trunk — the remote ref is exactly the branch this remote DECLARES as its
#     default. Asked of git rather than inferred from a name: a team whose default branch is called
#     anything else was measured against a name it does not use, so the guard ran, found nothing to
#     judge, and stayed quiet. Where nothing declares one — a repository wired up by hand rather than
#     cloned, or a push addressed to a URL rather than to a remote's name — the fallback candidates
#     stand in, which leaves such repositories exactly where they were.
#
#     The cost of asking is stated in full rather than hidden, and it is wider than the case that
#     motivated it. Where a declaration resolves, it REPLACES the candidates rather than joining them —
#     one definition of the trunk was the point — so the trunk name the remote does NOT declare stops
#     being defended, in every clone and not only in the exotic ones. A stale master left behind by a
#     rename, beside a declared main, is force-pushable and deletable now where it was not before; the
#     mirror holds for a master-default clone and its main.
#
#     And what is read is refs/remotes/<remote>/HEAD, which is what the remote declared AT CLONE TIME.
#     Neither fetch, nor fetch --prune, nor pull ever updates it; only an explicit
#     `git remote set-head <remote> -a` does. The verification above proves the target still exists, not
#     that it is still the remote's default, so a repository cloned when the default was master and
#     since renamed to main resolves master alone and accepts a force-push over main. That is the same
#     narrowing as the paragraph above with the declaration simply out of date, and it is named here
#     because a cost the operator can only discover by being bitten is not a cost that was stated.
#     --no-verify is the escape in every one of these cases.
#
#     Exact, not a substring and not a trailing segment: git accepts refs/heads/hotfix/main as an
#     ordinary branch and reports it whole, and an update reaching only refs/remotes/origin/main never
#     touches the remote's trunk. A widening operation does not hide behind either — when it genuinely
#     rewrites the trunk, git reports the exact ref like any other update. All three measured.
#
#   * a deletion — the local sha is all zeros. Deleting the trunk destroys it for everyone. Git refuses
#     this on its own for the branch a remote's HEAD points at, but NOT for a trunk-named branch
#     standing beside it; one such branch was removed from a test remote with exit 0 while the other
#     survived the same operation. That measurement is why this arm is not redundant.
#
#   * a rewrite — the commit the remote holds is not an ancestor of the one being sent, so it would stop
#     being reachable. This is the effect and not the order that produced it: a lease-guarded rewrite
#     arrives here byte-identically to an unguarded one, and both are refused, because a lease guards
#     against overwriting someone else's work rather than against rewriting the trunk.
#
# A remote sha of all zeros is the trunk being created on that remote, which destroys nothing.
#
# The escape is git's own --no-verify, and the refusal names it. A guard that hides its escape teaches
# people to route around it, and this one has never been a boundary against a deliberate bypass: it is a
# rail against a mistake, and it is sized accordingly.

set -u

# An absent object is reported as an all-zero name whose LENGTH is the repository's hash length — 40
# under SHA-1, 64 under SHA-256. Comparing against a fixed forty-character constant answered "not
# absent" for every ref in a SHA-256 repository, which turned a creation into a rewrite and a deletion
# into an update. The test is therefore on the shape, not on a constant.
is_absent() { case "${1:-x}" in *[!0]*|"") return 1 ;; *) return 0 ;; esac; }

# The refs that count as this remote's trunk. $1 is the remote's NAME when the push named one and its
# URL when it did not; nothing local answers for a URL, and that is the fallback path rather than an
# error.
#
# The rule is the diff brake's — global/hooks/diff-size-guard.py, base_ref — and the candidate list
# below is that function's own list. Restated here rather than shared because a shell hook cannot import
# it, and held to the original by a harness row that extracts both lists and fails unless they are the
# same list in the same order: a list restated beside its original drifts, a list a machine compares
# cannot.
#
# It translates rather than copies, because the two answer in different namespaces. The brake answers in
# refs/remotes/... since it needs a ref to diff against; what git reports here is the destination on the
# remote, in refs/heads/... The verification is the brake's too, and it is not optional: symbolic-ref
# answers even when the ref it points at is gone — a dangling origin/HEAD after a renamed default branch
# — and accepting that unverified would resolve a trunk that does not exist and defend nothing, in
# silence, which is the exact failure this guard was rewritten to remove.
#
# The candidates are NOT verified against the local repository the way the brake verifies its own. The
# brake needs a ref that exists to measure from; this needs a name to compare against, and a checkout
# that happens not to hold main locally would otherwise stop defending main on the remote.
trunks() {
  rp="refs/remotes/${1:-}/"
  ref="$(git symbolic-ref "${rp}HEAD" 2>/dev/null)" || ref=""
  #
  # Two gates, not one, and the second is the one that is easy to leave out. symbolic-ref accepts ANY
  # well-formed refname as its target, so refs/remotes/<remote>/HEAD may legitimately be read back
  # pointing outside its own namespace: `git symbolic-ref refs/remotes/origin/HEAD refs/heads/main` is
  # the form people paste when repairing a missing origin/HEAD, and the correct form names
  # refs/remotes/origin/main. Measured: it is accepted, rev-parse verifies it, the strip below is then a
  # no-op, and the emitted candidate is refs/heads/refs/heads/main -- a name git will never report, so
  # every ref falls through is_trunk and a force-push over the real trunk is allowed, silently. Checking
  # that the answer EXISTS is not checking that it has the shape the strip assumes; the case arm makes a
  # wrong shape fall through to the candidates like every other unresolvable answer, instead of past
  # them.
  if [ -n "$ref" ] && git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
    case "$ref" in
      "$rp"?*) printf 'refs/heads/%s\n' "${ref#"$rp"}"; return 0 ;;
    esac
  fi
  for cand in main master; do
    printf 'refs/heads/%s\n' "$cand"
  done
}

is_trunk() {  # $1 = the ref git reports for the remote side -> 0 when it is this remote's trunk
  for t in $TRUNKS; do
    [ "${1:-}" = "$t" ] && return 0
  done
  return 1
}

# The input is read twice — once here and once by whatever hook this repository had before the engine's
# arrived — so it is held rather than consumed. A stream cannot be rewound, and a chained hook handed an
# empty stdin would allow everything while appearing to run.
#
# Held in a variable and not in a temporary file. The file version stood aside in silence when it could
# not be created, which is a Never rule failing open on a full disk, and a short write would have handed
# the chained hook a truncated stream. There is nothing here to run out of: git sends one line per ref.
BUF="$(cat)"

TRUNKS="$(trunks "${1:-}")"

verdict=""
held=""
while read -r lref lsha rref rsha; do
  is_trunk "${rref:-}" || continue
  if is_absent "${lsha:-}"; then
    verdict="deleting $rref on the remote"
    break
  fi
  is_absent "${rsha:-}" && continue
  if ! git merge-base --is-ancestor "$rsha" "${lsha:-}" >/dev/null 2>&1; then
    verdict="rewriting $rref on the remote"
    held="$rsha"
    break
  fi
done <<EOF
$BUF
EOF

if [ -n "$verdict" ]; then
  {
    echo "BLOCKED: $verdict is forbidden (your 'Never' rule)."
    [ -n "$held" ] && echo "  The commit it holds ($(echo "$held" | cut -c1-9)) would stop being reachable."
    echo "  Send a branch instead. If you truly intend this, add --no-verify."
  } >&2
  exit 1
fi

# A repository that had a pre-push of its own keeps it: the engine's runs first and, having nothing to
# refuse, hands the same input on and adopts its verdict.
#
# Its copy is resolved through --git-common-dir and not through --git-path. With a hook path configured,
# --git-path resolves hooks/* to that configured directory — so a hook asking git for "this repository's
# own" would be handed itself and re-invoke without end. Measured: the naive form ran until it was
# killed. The path comparison below is the second half of the same guard, for the case where this file
# IS the repository's own copy.
common="$(git rev-parse --git-common-dir 2>/dev/null)" || common=""
[ -n "$common" ] || exit 0
own="$common/hooks/pre-push"
[ -x "$own" ] || exit 0

abspath() { ( cd "$(dirname "$1")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")" ); }
[ "$(abspath "$own")" = "$(abspath "$0")" ] && exit 0

"$own" "$@" <<EOF
$BUF
EOF
