#!/bin/sh
# pre-commit: a commit never records a secret.
#
# What decides is the index — the paths this commit would actually record — and nothing else. Not the
# command that produced it, not the message attached to it, not what happens to be lying in the working
# tree. That is the whole change: the guard this replaces read the command's text, so a message
# mentioning a secrets file and a search through the documentation for one were refused as stagings,
# while the index itself was never consulted.
#
# The PATH classification below is carried over unchanged in meaning from that guard: no rule about what
# counts as a secret BY NAME is invented here, only where the question is asked has moved. The content
# classification is new in this file and nothing preceded it — the guard this replaces judged the
# command's text and never the index's content — so the six shapes below were chosen and measured here.
#
# Two questions are asked of that index, not one. The first is the path — a name that has never been
# anything but a secret. The second is the CONTENT the commit would add, because a key pasted into an
# ordinary source file has an ordinary name and passes every test a name can make.
#
# Written in POSIX shell rather than in python3 deliberately. The guard this replaces stands aside when
# python3 is missing, which is tolerable for something that only ever declines to judge — but a commit
# hook that cannot start makes git refuse the commit, so an interpreter this file does not need would
# turn a missing dependency into a machine that cannot commit at all.
#
# The escape is git's own --no-verify, and the refusal names it: a guard that hides its escape teaches
# people to route around it, and this one is a rail against a mistake rather than a boundary against a
# deliberate bypass.

set -u

is_secret() {  # $1 = a path as git records it -> 0 when it must not be committed
  p="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  # The example forms come first: they exist to be committed, and they end in the same word the rule
  # below matches.
  case "$p" in
    *.env.example|*.env.template|*.env.sample|*.env.dist|*.env.local.example) return 1 ;;
  esac
  case "$p" in
    .env|.env.*|*/.env|*/.env.*) return 0 ;;
    *.pem|*.p12|*.pfx|*.jks|*.keystore) return 0 ;;
    id_rsa|id_dsa|id_ecdsa|id_ed25519) return 0 ;;
    */id_rsa|*/id_dsa|*/id_ecdsa|*/id_ed25519) return 0 ;;
    *service-account*.json|*service_account*.json|*serviceaccount*.json) return 0 ;;
  esac
  return 1
}

# The second question. Fixed shapes only: a private-key header, and five provider prefixes whose
# alphabet and length the issuer fixes. Not a measure of randomness — that raises false alarms on
# fixtures and sample data, and a guard people learn to ignore protects nothing. Measured over this
# repository's tracked files when these were chosen: zero matches.
#
# The Slack and Stripe shapes carry the issuer's whole form -- segment structure and all -- rather than
# the prefix and a lower bound. An open-ended tail is not a fixed shape: written as the prefix plus
# {10,} of the class, the Slack arm refuses the ordinary documentation placeholder, the one whose four
# words after the dash are `your`, `token` and `here`. These guards run on the operator's every commit,
# so a sample config or a README then costs them a --no-verify -- precisely the
# guard-people-learn-to-ignore this design refused entropy scanning to avoid, reached from the other
# side. The placeholder is spelled in pieces here for the same reason every shape is: this file must
# stay committable under its own rules, and under the looser ones it replaces.
#
# Each pattern is written so that the pattern's own text is not an instance of it: after `AKIA` the
# pattern has `[`, which is not in the class that must follow, and the same holds for every other one.
# That is what keeps this file — and the suite that drives it — committable with the guard active, and a
# row that stages both is what proves it rather than this paragraph. The alternative, exempting this
# file's own path, would create a file in which a real secret passed unseen.
#
# Two groups rather than one because the refusal names WHICH kind was found. It never prints the matched
# text: a guard that echoes the secret it caught has copied it into the scrollback, the CI log and the
# transcript, which is the outcome it exists to prevent.
KEYSHAPE='-----BEGIN [A-Z ]*PRIVATE KEY-----'
TOKENSHAPES='AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|xox[baprs]-[0-9]{10,}-[0-9]{10,}-[0-9A-Za-z]{20,}|sk_live_[0-9A-Za-z]{24,}|AIza[0-9A-Za-z_-]{35}'

adds() {  # $1 = a staged path, $2 = an ERE -> 0 when a line this commit ADDS to it matches
  # This pipeline's only output is grep's exit status, so it has no way to say "I could not look": every
  # way the diff can come back without + lines is indistinguishable from "this file adds no secret", and
  # every one of them lets the commit through in silence. Four flags close the four ways that happened,
  # each of them measured rather than imagined:
  #
  #   --text                a path marked -diff or binary in .gitattributes, and any file carrying a NUL
  #                         byte, answer `Binary files ... differ` and no + lines at all. Forcing the
  #                         textual read costs nothing on a real binary — none of the fixed shapes can
  #                         occur in one — and it is what stops a key pasted into a file the repository
  #                         happens to decline to diff from being exempt for good.
  #   --no-ext-diff         a diff.external / GIT_EXTERNAL_DIFF driver replaces the unified diff
  #                         entirely. That is configured globally, in the operator's own ~/.gitconfig
  #                         and outside any repository this guard defends, so without this flag the
  #                         content half is inert for every file in every repository they own.
  #   --no-textconv         a textconv attribute compares the converted text rather than the staged
  #                         bytes, so the bytes actually being recorded are never read.
  #   --literal-pathspecs   a staged path beginning with `:` is parsed as pathspec magic, matches
  #                         nothing, and exits 0 with no error and no output. Measured: the file is
  #                         exempt and nothing says so.
  #
  # The diff is piped and never captured into a variable: --text can put a real binary's bytes on
  # stdout, and those belong in grep.
  #
  # The file header `+++ b/path` is dropped by its trailing space, which a content line cannot carry in
  # that position: an added line reading `+++foo` arrives as `++++foo`. The one form this drops wrongly
  # is a line whose own text begins `++ ` — it errs towards a miss, never towards a false refusal.
  git -c core.quotePath=false --literal-pathspecs \
      diff --cached -U0 --text --no-ext-diff --no-textconv --diff-filter=ACMR -- "$1" 2>/dev/null \
    | grep -v '^+++ ' \
    | grep -Eq "^[+].*($2)"
}

# Only what the commit would add or change is read: a deletion records no content, so removing a secret
# that was committed by mistake must stay possible — refusing that would trap the repository in the
# state the guard exists to prevent.
#
# The listing is asked for without quoting and then split on newlines. A path containing a newline —
# pathological, and no earlier version of this guard handled one either — splits into two candidates,
# and the two questions below then fail in OPPOSITE directions on it. The path question classifies both
# fragments, so it errs towards a refusal with a stated escape. The content question hands each fragment
# to git as a pathspec, neither is a real path, both diffs come back empty, and the file is missed. The
# safer half is not claimed for both: a sentence that reads as one guarantee over two behaviours is the
# kind that survives exactly until someone relies on it.
danger=""
staged="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -z 2>/dev/null | tr '\0' '\n')"
OIFS="$IFS"; IFS='
'
for path in $staged; do
  [ -n "$path" ] || continue
  if is_secret "$path"; then
    danger="$danger  $path (the path is a secrets file)
"
  elif adds "$path" "$KEYSHAPE"; then
    danger="$danger  $path (a line it adds carries a private-key header)
"
  elif adds "$path" "$TOKENSHAPES"; then
    danger="$danger  $path (a line it adds carries a provider token)
"
  fi
done
IFS="$OIFS"

if [ -n "$danger" ]; then
  {
    echo "BLOCKED: this commit would record a secret:"
    printf '%s' "$danger"
    echo "  Unstage the file, or take the line back out and stage it again. If it truly belongs in the"
    echo "  repository, add --no-verify."
  } >&2
  exit 1
fi

# A repository that had a pre-commit of its own keeps it, on the same terms as the push guard: the
# engine's runs first and, having nothing to refuse, hands over and adopts its verdict. Its copy is
# resolved through --git-common-dir and not --git-path, because with a hook path configured the latter
# resolves hooks/* to that configured directory and would hand this file back to itself.
common="$(git rev-parse --git-common-dir 2>/dev/null)" || common=""
[ -n "$common" ] || exit 0
own="$common/hooks/pre-commit"
[ -x "$own" ] || exit 0

abspath() { ( cd "$(dirname "$1")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")" ); }
[ "$(abspath "$own")" = "$(abspath "$0")" ] && exit 0

"$own" "$@"
